{
  "schema_version": 1,
  "id": "gogallery-v1",
  "kind": "development",
  "engine": "codex",
  "source": {"url": "https://github.com/robrotheram/gogallery.git", "revision": "5f1bfd6a41afec65bc7ab791a14863180d944ee0"},
  "resources": {"cpu_cores": 1, "memory_bytes": 1073741824},
  "network_mode": "allowlist",
  "job_timeout_seconds": 600,
  "services": [{"name": "gallery", "port": 8080, "protocol": "http"}],
  "commands": {
    "build": ["go", "build", "-o", "outputs/gogallery", "."],
    "test": ["go", "test", "./..."]
  },
  "artifacts": ["outputs/gogallery"]
}
