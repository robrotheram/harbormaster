#!/bin/sh
set -eu
test "$(id -u)" = 0
test -c /dev/kvm
test -f /sys/fs/cgroup/cgroup.controllers
mkdir -p /sys/fs/cgroup/awb-firecracker
# Enable controls for the dedicated subtree without replacing host policies.
for controller in cpu memory pids; do
  echo "+$controller" > /sys/fs/cgroup/cgroup.subtree_control
  echo "+$controller" > /sys/fs/cgroup/awb-firecracker/cgroup.subtree_control
done
install -d -m 0700 /var/lib/agent-workbench/firecracker /srv/agent-workbench-jailer /run/agent-workbench
