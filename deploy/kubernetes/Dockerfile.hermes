# Optional overlay; build from repository root. WORKSPACE_BASE must be reviewed
# and pinned by digest. Source arguments come from deploy/hermes/runtime.json.
ARG WORKSPACE_BASE
FROM python:3.14-slim-bookworm AS hermes-build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libolm-dev git && rm -rf /var/lib/apt/lists/*
ARG HERMES_COMMIT
ARG HERMES_SOURCE_SHA256
ADD --checksum=sha256:${HERMES_SOURCE_SHA256} https://codeload.github.com/NousResearch/hermes-agent/tar.gz/${HERMES_COMMIT} /tmp/hermes.tgz
RUN mkdir /opt/hermes && tar -xzf /tmp/hermes.tgz -C /opt/hermes --strip-components=1 && python -m pip install --no-cache-dir uv==0.13.7 && cd /opt/hermes && uv sync --frozen --no-dev --extra matrix --extra mcp
FROM ${WORKSPACE_BASE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libolm3 && rm -rf /var/lib/apt/lists/*
COPY --from=hermes-build /usr/local/ /usr/local/
COPY --from=hermes-build /opt/hermes /opt/hermes
COPY scripts/hermes-runner.py /usr/local/bin/hermes-runner
COPY scripts/hermes_common.py /usr/local/bin/hermes_common.py
COPY scripts/hermes-digest.py /usr/local/bin/hermes-digest
COPY scripts/hermes-consume.py /usr/local/bin/hermes-consume
COPY deploy/hermes/runtime.json /usr/local/bin/hermes-runtime.json
RUN chmod 755 /usr/local/bin/hermes-runner /usr/local/bin/hermes-digest /usr/local/bin/hermes-consume && PYTHONPATH=/opt/hermes /usr/local/bin/hermes-runner --version
USER 10001:10001
# Preserve workspace base ENTRYPOINT; never use the Firecracker init process.
