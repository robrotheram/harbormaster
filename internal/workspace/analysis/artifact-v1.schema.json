{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harbormaster visualization artifact 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "type", "title", "data", "visualization"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "type": {"enum": ["table", "chart", "geo"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "reference"],
      "properties": {
        "source_type": {"enum": ["dataset", "query_result"]},
        "reference": {"$ref": "#/$defs/id"}
      }
    },
    "visualization": {"type": "object"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "created_at": {"type": "string", "format": "date-time", "maxLength": 40}
      }
    }
  },
  "oneOf": [
    {"properties": {"type": {"const": "table"}, "visualization": {"$ref": "#/$defs/table"}}},
    {"properties": {"type": {"const": "chart"}, "visualization": {"$ref": "#/$defs/chart"}}},
    {"properties": {"type": {"const": "geo"}, "visualization": {"$ref": "#/$defs/geo"}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"},
    "field": {"type": "string", "minLength": 1, "maxLength": 256},
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_size": {"type": "integer", "minimum": 1, "maximum": 500},
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field"],
            "properties": {"field": {"$ref": "#/$defs/field"}}
          }
        },
        "sortable": {"type": "boolean"},
        "filterable": {"type": "boolean"}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "type"],
      "properties": {
        "field": {"$ref": "#/$defs/field"},
        "type": {"enum": ["temporal", "quantitative", "nominal"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "chartColors": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/field"},
      "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart_type", "encoding"],
      "properties": {
        "chart_type": {"enum": ["line", "bar", "scatter", "histogram", "pie"]},
        "encoding": {"type": "object"},
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category_colors": {"$ref": "#/$defs/chartColors"},
            "series_colors": {"$ref": "#/$defs/chartColors"},
            "gridlines": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"x": {"type": "boolean"}, "y": {"type": "boolean"}}
            }
          }
        }
      },
      "if": {"properties": {"chart_type": {"const": "pie"}}},
      "then": {
        "properties": {
          "encoding": {
            "additionalProperties": false,
            "required": ["category", "value"],
            "properties": {
              "category": {"$ref": "#/$defs/field"},
              "value": {"$ref": "#/$defs/field"}
            }
          },
          "style": {"propertyNames": {"const": "category_colors"}}
        }
      },
      "else": {
        "properties": {
          "encoding": {
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {"$ref": "#/$defs/axis"},
              "y": {"$ref": "#/$defs/axis"},
              "series": {"$ref": "#/$defs/field"}
            }
          }
        }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "coordinate_system", "encoding", "view"],
      "properties": {
        "geometry": {"enum": ["point", "path", "polygon", "geojson"]},
        "layer": {"enum": ["points", "heatmap", "grid", "hexagon", "contour", "screen_grid"]},
        "radius_px": {"type": "integer", "minimum": 8, "maximum": 100},
        "cell_size_m": {"type": "integer", "minimum": 10, "maximum": 10000000},
        "radius_m": {"type": "integer", "minimum": 10, "maximum": 10000000},
        "cell_size_px": {"type": "integer", "minimum": 8, "maximum": 128},
        "thresholds": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "coordinate_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["geographic", "projected", "cartesian"]},
            "crs": {"type": "string", "pattern": "^EPSG:[1-9][0-9]{0,7}$"}
          }
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {"$ref": "#/$defs/field"},
            "y": {"$ref": "#/$defs/field"},
            "color": {"$ref": "#/$defs/field"},
            "group": {"$ref": "#/$defs/field"},
            "weight": {"$ref": "#/$defs/field"},
            "shape": {"$ref": "#/$defs/field"}
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["map", "cartesian"]},
            "auto_fit": {"type": "boolean"}
          }
        }
      }
    }
  }
}
