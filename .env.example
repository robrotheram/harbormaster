COMPOSE_PROJECT_NAME=agent-workbench
DEPLOYMENT_ID=awb
DASHBOARD_PORT=8080
# Direct Compose invocations can set this to the numeric group of the Docker socket.
# make up determines it automatically.
# DOCKER_SOCKET_GID=0
CONTROL_PORT=8090
MCP_PORT=8082
REQUIRE_VERIFIED_ISOLATION=false
GATEWAY_MODE=fixture
INFERENCE_MODEL=fixture
# Native subscription agents are opt-in via the dashboard. See docs/subscription-agents.md.
WORKSPACE_AGENT=
CODEX_MODEL=gpt-6.1-sol
CLAUDE_MODEL=
INFERENCE_POLICY_FILE=./config/inference.json

# Interactive native T3 server in newly created workspace containers.
WORKSPACE_T3=true
WORKSPACE_MEMORY_BYTES=1073741824
MEMORY_QUOTA_BYTES=4294967296

# Hosted WorkOS AuthKit requires scoped dashboard credentials and removal of
# the local control-token mount. See docs/authkit.md to mount the API key as a file.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_ALLOWED_EMAILS=
# Register http://127.0.0.1:8080/auth/callback in WorkOS Redirect URIs.
# Leave empty for that default; HTTPS required except for loopback development.
WORKOS_REDIRECT_URI=

# Optional single shared T3 workspace for every project; empty retains project-private workers.
SHARED_WORKSPACE_ID=
