COMPOSE_PROJECT_NAME=agent-workbench
DEPLOYMENT_ID=awb
DASHBOARD_PORT=8080
CONTROL_PORT=8090
MCP_PORT=8082
WORKSPACE_RUNTIME=docker
REQUIRE_VERIFIED_ISOLATION=false
GATEWAY_MODE=fixture
INFERENCE_MODEL=fixture
# Native subscription agents are opt-in via scripts/subscription_auth.py.
WORKSPACE_AGENT=
CODEX_MODEL=gpt-6.1-sol
CLAUDE_MODEL=
INFERENCE_POLICY_FILE=./config/inference.json

# Interactive native T3 server in newly created workspace containers.
WORKSPACE_T3=true
WORKSPACE_MEMORY_BYTES=1073741824
MEMORY_QUOTA_BYTES=4294967296
