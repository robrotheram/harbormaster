COMPOSE_PROJECT_NAME=agent-workbench
DEPLOYMENT_ID=awb
DASHBOARD_PORT=8080
CONTROL_PORT=8090
MCP_PORT=8082
WORKSPACE_RUNTIME=docker
REQUIRE_VERIFIED_ISOLATION=false
GATEWAY_MODE=fixture
INFERENCE_MODEL=fixture
# Native subscription agents are opt-in via scripts/subscription_auth.py.
WORKSPACE_AGENT=
CODEX_MODEL=gpt-6.1-sol
CLAUDE_MODEL=
INFERENCE_POLICY_FILE=./config/inference.json

# Interactive native T3 server in newly created workspace containers.
WORKSPACE_T3=true
WORKSPACE_MEMORY_BYTES=1073741824
MEMORY_QUOTA_BYTES=4294967296

# Optional WorkOS AuthKit protection for the shared operator dashboard.
# All three values are required to enable auth; partial configuration fails closed.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_ALLOWED_EMAILS=
# Register http://127.0.0.1:8080/auth/callback in WorkOS Redirect URIs.
# Leave empty for that default; HTTPS required except for loopback development.
WORKOS_REDIRECT_URI=
