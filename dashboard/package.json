{
  "name": "agent-workbench-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.preview.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:connections": "playwright test --config playwright.connection.config.ts",
    "test:browser:install": "playwright install chromium",
    "format": "prettier --write src *.config.ts tests",
    "format:check": "prettier --check src *.config.ts tests"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.1",
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/maplibre": "^9.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "^1.6.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "ghostty-web": "0.4.0",
    "html2canvas": "1.4.1",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "^6.19.0",
    "pdfmake": "^0.3.15",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.4",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }
  }
}
